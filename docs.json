{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Nohead",
  "colors": {
    "primary": "#171717",
    "light": "#fafafa",
    "dark": "#171717"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://nohead.io"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart"]
          },
          {
            "group": "Content",
            "pages": ["guides/content-modelling", "guides/publishing", "guides/history", "guides/field-migrations", "guides/images"]
          },
          {
            "group": "Search",
            "pages": ["guides/api-search", "guides/public-search"]
          },
          {
            "group": "Integrate",
            "pages": ["guides/sdks", "guides/webhooks", "guides/errors-and-retries", "guides/api-requests", "guides/schema-as-code", "guides/coding-agents", "guides/mcp"]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["api-reference/overview"]
          },
          {
            "group": "Endpoints",
            "openapi": "openapi.json"
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": ["curl", "typescript", "python", "ruby"]
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/nohead_io",
      "github": "https://github.com/nohead-io"
    }
  }
}
